# Copy to .env and fill in real values.

# REQUIRED. Free tier: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rill?retryWrites=true&w=majority

# Any long random string
JWT_SECRET=replace_with_a_long_random_string

CLIENT_ORIGIN=http://localhost:5173

# Used by the QR generator script to build report links
CLIENT_BASE_URL=http://localhost:5173

UPLOAD_DIR=uploads

# Database name used regardless of what's in MONGODB_URI's path.
# Change this if you want a different db name than "rill".
MONGODB_DB_NAME=rill

# Optional — only used by run.py (the `python run.py` entrypoint).
PORT=4000

# Optional — DEBUG, INFO, WARNING, or ERROR. Defaults to INFO.
LOG_LEVEL=INFO
